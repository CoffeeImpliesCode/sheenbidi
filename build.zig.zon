// SPDX-License-Identifier: Apache-2.0
.{
    .name = .sheenbidi,
    // Upstream release version pinned in build.zig.
    .version = "3.0.0",
    // Package fingerprint; changing it affects package identity.
    .fingerprint = 0x684adc4fabea833c, // Changing this has security and trust implications.
    .minimum_zig_version = "0.16.0",

    .dependencies = .{},

    .paths = .{
        "build.zig",
        "build.zig.zon",
        // Fork-authored Zig facade.
        "zig",
        // Runtime loader and dispatch.
        "runtime",
        // Cross-test harness profile.
        "cross-test.profile.sh",
        "tests.zig",
        "smoke.zig",
        // Consumer package for the public module.
        "consumer/build.zig",
        "consumer/build.zig.zon",
        "consumer/src/main.zig",
        // Upstream C headers and sources.
        "Headers",
        "Source",
        // Upstream Unicode inputs and generator; not run by this build.
        "Tools",
        "Tests",
        // Upstream build definitions retained for provenance.
        "CMakeLists.txt",
        "Makefile",
        "meson.build",
        "meson_options.txt",
        "SheenBidi.cmake.in",
        "sheenbidi.pc.in",
        "LICENSE",
        "README.md",
        "README.upstream.md",
        "UPSTREAM.md",
        "UPSTREAM.sha256",
        "README.zig.md",
        "NOTICE.md",
        "FORK-LICENSE.md",
        "CHANGELOG.md",
        "FORK-NOTES.md",
        // Nix and devenv packaging inputs.
        "package.nix",
        "flake.nix",
        "flake.lock",
        "devenv.nix",
        "devenv.yaml",
        ".envrc",
        // Ignore rules for package copies.
        ".gitignore",
    },
}
