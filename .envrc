# SPDX-License-Identifier: Apache-2.0
#
# Canonical way into this SDK's development environment: `devenv shell`, or
# `direnv allow` to have this file do it for you.
#
# `devenv direnvrc` is devenv's own direnv integration, so this file carries no
# URL and no pinned hash of its own — the revision that decides what `devenv
# shell` evaluates is the one in `devenv.yaml`.
export DIRENV_WARN_TIMEOUT=20s

eval "$(devenv direnvrc)"

# `use devenv` accepts the same options as `devenv shell`, e.g.
# `use devenv --quiet`.
use devenv